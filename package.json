{
  "name": "koinonia",
  "version": "1.20.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build && npm run build:worker",
    "build:worker": "esbuild src/modules/audio/worker/runner.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/worker.mjs",
    "start": "next start",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed-dev.ts",
    "worker": "tsx src/modules/audio/worker/runner.ts",
    "dev:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "dev:reset": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec app npm run db:migrate:deploy && docker compose -f docker-compose.yml -f docker-compose.dev.yml exec app npm run db:seed:dev",
    "lint": "eslint . --max-warnings=0",
    "lint:boundaries": "depcruise src/core src/modules src/app --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixture:training": "tsx prisma/scripts/build-training-fixture.ts",
    "db:seed:training": "SEED_FIXTURE_FILE=prisma/fixtures/training-real.json tsx prisma/seed-dev.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "archiver": "^7.0.1",
    "exceljs": "^4.4.0",
    "html2canvas-pro": "^2.4.1",
    "jspdf": "^4.2.1",
    "mariadb": "^3.5.4",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.0.6",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-h5-audio-player": "^3.10.2",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "^3.5.3"
    },
    "mysql2": "^3.24.2",
    "fast-uri": "^3.1.7",
    "nodemailer": "^9.0.6",
    "deepmerge-ts": "^8.0.0",
    "uuid": "^11.1.1"
  }
}
